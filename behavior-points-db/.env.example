# Local development (matches docker-compose.yml — works out of the box)
DATABASE_URL=postgresql://app:app_password@localhost:5432/behavior_points

# Production — fill in after creating your Supabase / Neon project,
# then swap this in for DATABASE_URL when you deploy.
# Most hosted Postgres providers require sslmode=require.
# PROD_DATABASE_URL=postgresql://<user>:<password>@<host>/<database>?sslmode=require
