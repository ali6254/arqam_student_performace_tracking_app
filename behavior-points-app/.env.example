# Points at the local Postgres from the behavior-points-db docker-compose setup.
# Swap for your Supabase/Neon connection string when you deploy.
DATABASE_URL=postgresql://app:app_password@localhost:5432/behavior_points

# Used to sign session cookies. Generate a real one with:
#   openssl rand -base64 32
SESSION_SECRET=replace-this-with-a-long-random-string
